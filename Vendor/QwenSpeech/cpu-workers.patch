--- a/src/qwen3_tts.cpp
+++ b/src/qwen3_tts.cpp
@@ -661,6 +661,7 @@
 } // namespace
 
 struct qwen3_tts_context {
+    ggml_threadpool_t reader_workers = nullptr;
     bool (*should_cancel)() = nullptr;
     std::string narration_text;
     std::vector<float> narration_frames;
@@ -1167,7 +1168,11 @@
     // range and mask the tail with -inf) don't see uninitialised F16 NaN
     // bytes on backends where ggml_backend_alloc_buffer doesn't clear
     // (CUDA, parts of CPU). Mirrors the cp_kv_alloc fix from commit 7298dd5.
-    ggml_backend_buffer_clear(c->kv_buf, 0);
+    // The CPU dynamic-length graph writes every K/V row before it can be read.
+    // Leave untouched pages uncommitted; fixed-length bucket graphs read the padded tail.
+    if (c->backend != c->backend_cpu || env_bool("CRISPASR_QWEN3_TTS_LK_BUCKET")) {
+        ggml_backend_buffer_clear(c->kv_buf, 0);
+    }
     c->kv_max_ctx = max_ctx;
     if (c->params.verbosity >= 1) {
         fprintf(stderr, "qwen3_tts: kv cache %d MiB (head_dim=%d max_ctx=%d n_kv=%d n_layers=%d)\n",
@@ -6513,6 +6518,11 @@
         fprintf(stderr, "qwen3_tts: loaded %s  (talker %uL/%u  code_pred %uL  vocab %u)\n", path_model, c->hp.n_layers,
                 c->hp.d_model, c->hp.cp_n_layers, c->hp.vocab_size);
     }
+    if (c->backend == c->backend_cpu && c->n_threads > 1) {
+        auto workers = ggml_threadpool_params_default(c->n_threads);
+        c->reader_workers = ggml_threadpool_new(&workers);
+        ggml_backend_cpu_set_threadpool(c->backend_cpu, c->reader_workers);
+    }
     return c;
 }
 
@@ -8421,6 +8431,10 @@
     if (ctx->backend_codec && ctx->backend_codec != ctx->backend && ctx->backend_codec != ctx->backend_cpu) {
         ggml_backend_free(ctx->backend_codec);
     }
+    if (ctx->reader_workers) {
+        ggml_backend_cpu_set_threadpool(ctx->backend_cpu, nullptr);
+        ggml_threadpool_free(ctx->reader_workers);
+    }
     if (ctx->backend_cpu) {
         ggml_backend_free(ctx->backend_cpu);
     }
