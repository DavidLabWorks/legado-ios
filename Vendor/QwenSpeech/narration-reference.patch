+// Keep a short, known recording of the selected stock voice in the acoustic
+// context. Only newly predicted frames are decoded and sent to the player.
+extern "C" int legado_qwen_set_narrator(qwen3_tts_context* ctx, const char* name,
+                                        const char* transcript, const uint8_t* codes, size_t bytes) {
+    if (!ctx || !transcript || !*transcript || !codes || bytes == 0 ||
+        ctx->hp.n_code_groups != 16 || bytes % 32 != 0 || bytes / 32 > 120)
+        return -1;
+    if (qwen3_tts_set_speaker_by_name(ctx, name) != 0)
+        return -1;
+    const int d = (int)ctx->hp.d_model;
+    std::vector<float> frames((bytes / 32) * d), scratch(d);
+    for (size_t frame = 0; frame < bytes / 32; ++frame) {
+        int32_t ids[16];
+        for (int cb = 0; cb < 16; ++cb) {
+            const uint8_t* p = codes + frame * 32 + 2 * cb;
+            ids[cb] = p[0] | (p[1] << 8);
+            const ggml_tensor* table = cb == 0 ? ctx->talker.token_embd_w : ctx->code_pred.codec_embd[cb - 1];
+            if (!table || ids[cb] >= table->ne[1])
+                return -1;
+        }
+        if (!qwen3_tts_sum_frame_embed(ctx, ids, 16, d, scratch, frames.data() + frame * d))
+            return -1;
+    }
+    ctx->narration_text = transcript;
+    ctx->narration_frames = std::move(frames);
+    return 0;
+}
